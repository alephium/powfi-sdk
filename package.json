{
  "name": "@zetamarket/typescript-sdk",
  "version": "0.0.4",
  "description": "Typescript SDK for Zeta Market",
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "src",
    "cpmm",
    "clmm"
  ],
  "scripts": {
    "build": "node ./node_modules/tsup/dist/cli-default.js src --format cjs,esm --dts --sourcemap --no-splitting -d lib",
    "dev": "node ./node_modules/tsup/dist/cli-default.js src --watch --format cjs,esm --dts --sourcemap --no-splitting -d lib",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "node ./node_modules/eslint/bin/eslint.js --max-warnings=0 . --ext .ts",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf lib",
    "prepublishOnly": "npm run build",
    "lint:fix": "npm run lint -- --fix",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "alephium",
    "cpmm",
    "clmm",
    "dex",
    "defi",
    "blockchain",
    "sdk",
    "zetamarkets"
  ],
  "author": "Zeta Markets",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zetamarkets/zeta-alephium-sdk.git"
  },
  "dependencies": {
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "@alephium/web3-test": "^v2.0.3"
  },
  "peerDependencies": {
    "@alephium/token-list": "0.0.20",
    "@alephium/web3": "^v2.0.3"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
