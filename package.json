{
  "name": "@alephium/powfi-sdk",
  "version": "1.0.0",
  "description": "Typescript SDK for Alephium Powfi",
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "clmm",
    "cpmm",
    "staking"
  ],
  "scripts": {
    "build": "bunx tsup",
    "copy-artifacts": "set -e; test -d \"${CONTRACTS_DIR:?set CONTRACTS_DIR to the contracts packages directory}/clmm/artifacts\"; for p in clmm cpmm staking; do rm -rf $p; mkdir -p $p/deployments; cp -R \"$CONTRACTS_DIR/$p/artifacts\" $p/; cp \"$CONTRACTS_DIR/$p/deployments\"/.deployments.*.json $p/deployments/; done",
    "dev": "bunx tsup src --watch --format cjs,esm --dts --sourcemap --no-splitting -d lib",
    "test": "bunx vitest run",
    "test:watch": "bunx vitest",
    "test:coverage": "bunx vitest run --coverage",
    "lint": "bunx eslint --max-warnings=0 . --ext .ts",
    "format": "bunx prettier --write .",
    "typecheck": "bunx tsc --noEmit",
    "clean": "rm -rf lib",
    "prepublishOnly": "bun run build",
    "lint:fix": "bun run lint -- --fix",
    "format:check": "bunx prettier --check ."
  },
  "keywords": [
    "alephium",
    "cpmm",
    "clmm",
    "staking",
    "dex",
    "defi",
    "blockchain",
    "sdk",
    "powfi"
  ],
  "author": "Powfi",
  "license": "LGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/alephium/powfi-sdk.git"
  },
  "homepage": "https://github.com/alephium/powfi-sdk#readme",
  "bugs": {
    "url": "https://github.com/alephium/powfi-sdk/issues"
  },
  "dependencies": {
    "@alephium/token-list": "0.0.20",
    "@alephium/web3": "3.0.3",
    "bignumber.js": "^10.0.2",
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "@alephium/web3-test": "3.0.3",
    "@alephium/web3-wallet": "3.0.3",
    "@types/node": "20",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "keccak256": "^1.0.6",
    "prettier": "^3.2.5",
    "tsup": "^8.0.1",
    "vitest": "^4.1.4",
    "typescript": "^5.9.3"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.0.0"
  }
}
